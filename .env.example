# MediCore HMS — Environment Configuration Template
# Copy to .env for local development. NEVER commit .env or real secrets.

# Application
APP_NAME=MediCore HMS
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security (REPLACE in any shared/non-local environment)
SECRET_KEY=dev-only-insecure-secret-key-change-before-staging-min-32-chars
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (Separate migration role and restricted application role)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=medicore_hms
POSTGRES_MIGRATOR_USER=medicore_migrator
POSTGRES_MIGRATOR_PASSWORD=dev_migrator_password_change_me
POSTGRES_APP_USER=medicore_app
POSTGRES_APP_PASSWORD=dev_app_password_change_me

# Database URLs (used by backend & alembic)
DATABASE_URL=postgresql+asyncpg://medicore_app:dev_app_password_change_me@postgres:5432/medicore_hms
DATABASE_MIGRATION_URL=postgresql+psycopg://medicore_migrator:dev_migrator_password_change_me@postgres:5432/medicore_hms

# Redis
REDIS_URL=redis://redis:6379/0

# S3-Compatible Private Object Storage (MinIO locally)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=medicore_minio_dev
S3_SECRET_ACCESS_KEY=medicore_minio_dev_secret
S3_BUCKET_NAME=medicore-private-docs
S3_REGION=ap-south-1
S3_USE_SSL=false

# Localization & Hospital Defaults
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
DEFAULT_LOCALE=en-IN

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_ENABLE_PHASE0_PREVIEWS=true
